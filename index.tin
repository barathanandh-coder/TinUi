component Main():
    AnimatedBackground(effect="quantum-vortex", primaryColor="neon-purple", secondaryColor="neon-cyan"):
        
        Navbar(padding=20, blur=true):
            Row(align="center", justify="space-between", width="full"):
                Row(align="center", gap=10):
                    Text(text="TinPyUI v1.6.0", color="neon-cyan", weight="bold")
                
                Row(gap=30, color="white"):
                    NavLink(text="Documentation")
                    NavLink(text="GitHub")

        Section(align="center", paddingY=80, maxWidth=800, justify="center"):
            GradientText(text="TinPyUI Framework v1.6.0", gradient=["neon-cyan", "neon-purple"], size="hero")
            Text(text="Hybrid DOM + WebGL Hardware-Accelerated UI Engine with Pythonic Syntax", size="large", color="white", weight="bold", marginTop=20)
            
            Row(gap=20, align="center", justify="center", marginTop=40):
                Button(text="Get Started", variant="solid", glow="neon-cyan", radius="pill")
                Button(text="Documentation", variant="outline", radius="pill")
